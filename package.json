{
  "name": "brevly",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-dev-database.mjs",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "npm run db:migrate -w server",
    "check": "npm run typecheck && npm test && npm run build",
    "test:integration": "npm run test:integration -w server",
    "test:e2e": "npm run test:e2e -w web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "esbuild": "^0.28.2"
  }
}
