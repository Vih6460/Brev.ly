{
  "name": "brevly",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run serve",
    "preserve": "node scripts/ensure-docker-services.mjs",
    "serve": "npm run dev -w web -- --strictPort",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "db:migrate": "docker compose run --build --rm migrate",
    "check": "npm run typecheck && npm test && npm run build",
    "pretest:integration": "docker compose -f compose.test.yaml up -d --wait postgres",
    "test:integration": "npm run test:integration -w server",
    "pretest:e2e": "docker compose -f compose.test.yaml up --build -d --wait",
    "test:e2e": "npm run test:e2e -w web"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "esbuild": "^0.28.2"
  }
}
